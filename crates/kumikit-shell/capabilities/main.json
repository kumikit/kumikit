{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: the connection bridge, the client plugin store and the open dialog (ADR 0013).",
  "windows": ["main"],
  "permissions": [
    "allow-bridge-connect",
    "allow-bridge-send",
    "allow-bridge-close",
    "allow-client-plugins-list",
    "allow-client-plugins-install",
    "allow-client-plugins-remove",
    "dialog:allow-open"
  ]
}
