{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: the connection bridge, remote profiles, the client plugin store with its registries, and the open dialog (ADR 0013, ADR 0017, ADR 0018).",
  "windows": ["main"],
  "permissions": [
    "allow-bridge-connect",
    "allow-bridge-send",
    "allow-bridge-close",
    "allow-client-plugins-list",
    "allow-client-plugins-install",
    "allow-client-plugins-remove",
    "allow-client-plugins-install-registry",
    "allow-client-plugins-updates",
    "allow-client-plugins-update",
    "allow-client-registry-search",
    "allow-client-registries-get",
    "allow-client-registries-set",
    "allow-client-lock",
    "allow-profiles-list",
    "allow-profile-probe",
    "allow-profile-pair",
    "allow-profile-add-ssh",
    "allow-profile-remove",
    "allow-pick-attachments",
    "dialog:allow-open"
  ]
}
