{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: the connection bridge, remote profiles, SSH core sync, signed app updates, the client plugin store with its registries, and the open dialog (ADR 0013, ADR 0017, ADR 0018, ADR 0031, ADR 0032).",
  "windows": ["main"],
  "permissions": [
    "allow-bridge-connect",
    "allow-bridge-send",
    "allow-bridge-close",
    "allow-client-plugins-list",
    "allow-client-plugins-install",
    "allow-client-plugins-remove",
    "allow-client-plugins-install-registry",
    "allow-client-plugins-updates",
    "allow-client-plugins-update",
    "allow-client-registry-search",
    "allow-client-registries-get",
    "allow-client-registries-set",
    "allow-client-lock",
    "allow-profiles-list",
    "allow-profile-probe",
    "allow-profile-pair",
    "allow-profile-add-ssh",
    "allow-profile-update-ssh",
    "allow-profile-remove",
    "allow-ssh-probe",
    "allow-ssh-sync",
    "allow-app-update-info",
    "allow-app-update-check",
    "allow-app-update-download",
    "allow-app-update-apply",
    "allow-window-chrome",
    "allow-pick-attachments",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-is-maximized",
    "core:window:allow-is-fullscreen",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open"
  ]
}
