package kumikit:threads@0.2.0;

/// Additional client operations for threads: deferred messages (ADR 0027), queue
/// inspection/editing, bounded event reads, agent-suggested titles (ADR 0030), and model
/// listing and thread creation with model settings and a bounded permission mode
/// (ADR 0034). Linked for base and tool plugins; every operation checks
/// `permissions.client` and `permissions.workspaces`.
interface client {
  use kumikit:host/types@0.2.0.{error};
  use kumikit:host/client@0.2.0.{thread};

  /// `threads.defer`: queues a message waiting on a `QueueTrigger` (JSON). Returns the
  /// created `QueueEntry` as JSON. Command triggers also need `permissions.spawn` for
  /// the program and user approval unless the thread is in `full_access`.
  defer: func(thread: string, text: string, trigger-json: string) -> result<string, error>;

  /// `threads.queue`: lists the thread's queued and deferred messages as a JSON array of
  /// `QueueEntry`.
  list-queue: func(thread: string) -> result<string, error>;

  /// `threads.queue`: removes a queued or deferred message by entry id.
  remove-queued: func(thread: string, entry: string) -> result<_, error>;

  /// `threads.read`: reads up to `limit` (clamped to 200) events of `thread` with
  /// `seq > after` as a JSON array of `{ seq, time, kind, data }`.
  read-events: func(thread: string, after: u64, limit: u32) -> result<string, error>;

  /// `threads.title.suggest`: sets the thread's title unless the user has renamed it
  /// (`titleSource == "user"`). Returns whether the title was updated.
  suggest-title: func(thread: string, title: string) -> result<bool, error>;

  /// `threads.create`: the models of a provider (qualified id), the first being the
  /// default, as the JSON array `provider.models` returns in `models` (each with `id`,
  /// `label`, `capabilities` and `options`, its settings).
  list-models: func(provider: string) -> result<string, error>;

  /// What `create-thread` starts.
  record create-request {
    /// The workspace; the plugin must be allowed to act in it.
    workspace: string,
    /// Qualified provider id; defaults as in `thread.create`.
    provider: option<string>,
    /// Model id; defaults to the provider's first model.
    model: option<string>,
    title: option<string>,
    /// Model settings, by setting id (`effort` → `medium`), checked against the model.
    options: list<tuple<string, string>>,
    /// `plan`, `standard` or `accept_edits`; `full_access` is refused. With none, the
    /// thread gets `standard`, or `origin`'s mode if that is stricter.
    permission-mode: option<string>,
    /// The thread the plugin acts for (for a tool, `tool-call.thread`). It must be in
    /// `workspace`, and the new thread may not be looser than it (strictest first:
    /// `plan`, `standard`, `accept_edits`, `full_access`).
    origin: option<string>,
  }

  /// `threads.create`: a new thread. Fails with `permission-denied` for a refused
  /// permission mode and `invalid-argument` for unknown models or settings.
  create-thread: func(request: create-request) -> result<thread, error>;
}

/// Only the thread-ops import, for plugins built for `kumikit:plugin/plugin@0.2.0`
/// or `kumikit:tool/plugin@0.1.0`.
world client-threads {
  import client;
}
