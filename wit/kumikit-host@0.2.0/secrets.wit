package kumikit:host@0.2.0;

/// Secrets the user stored on the core. A plugin may read only the names listed in its
/// manifest's `permissions.secrets`; any other name fails with `permission-denied`.
interface secrets {
  use types.{error};

  /// The secret's value, or none if it is not set.
  get: func(name: string) -> result<option<string>, error>;
}
