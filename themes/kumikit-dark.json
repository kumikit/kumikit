{
  "$schema": "https://kumikit.dev/schema/theme-0.1.json",
  "id": "kumikit-dark",
  "name": "Kumikit Dark",
  "appearance": "dark",
  "tokens": {
    "surface.frame": "#0e1014",
    "surface.panel": "#15171c",
    "surface.card": "#1b1e24",
    "surface.raised": "#21242b",
    "surface.overlay": "#000000",
    "surface.input": "#101216",
    "surface.hover": "#23262e",
    "surface.selected": "#283249",
    "text.primary": "#e6e8ee",
    "text.secondary": "#b3b8c4",
    "text.muted": "#8d93a2",
    "text.on-accent": "#0b0d12",
    "text.link": "#8fb0ff",
    "accent": "#7d9df6",
    "accent.hover": "#95b0f8",
    "accent.tint": "#1e2944",
    "focus": "#8fb0ff",
    "border.subtle": "#2b2f37",
    "border.strong": "#6c7383",
    "state.success": "#4cc38a",
    "state.warning": "#e0a640",
    "state.danger": "#f0767d",
    "state.info": "#6ea8fe",
    "state.success.tint": "#14301f",
    "state.warning.tint": "#352a12",
    "state.danger.tint": "#3a1a1d",
    "state.info.tint": "#172945",
    "code.background": "#101216",
    "code.text": "#e6e8ee",
    "syntax.keyword": "#c792ea",
    "syntax.string": "#a5d68a",
    "syntax.number": "#f5a76c",
    "syntax.comment": "#8d93a2",
    "syntax.function": "#82aaff",
    "syntax.type": "#7fd6d2",
    "diff.added": "#4cc38a",
    "diff.removed": "#f0767d",
    "diff.added.tint": "#14301f",
    "diff.removed.tint": "#3a1a1d",
    "shadow.card": "0 1px 2px rgba(0, 0, 0, 0.4)",
    "shadow.raised": "0 4px 12px rgba(0, 0, 0, 0.45)",
    "shadow.overlay": "0 12px 32px rgba(0, 0, 0, 0.6)",
    "overlay.opacity": "0.6",
    "font.ui": "system-ui, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif",
    "font.mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace",
    "font.size.small": "12px",
    "font.size.base": "14px",
    "font.size.large": "16px",
    "font.size.title": "20px",
    "font.weight.normal": "400",
    "font.weight.strong": "600",
    "line-height.base": "1.5",
    "radius.small": "4px",
    "radius.medium": "6px",
    "radius.large": "10px",
    "overlay.blur": "8px",
    "motion.duration.short": "120ms",
    "motion.duration.medium": "200ms",
    "motion.ease.out": "cubic-bezier(0.2, 0, 0, 1)"
  }
}
