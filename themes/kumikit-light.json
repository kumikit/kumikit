{
  "$schema": "https://kumikit.dev/schema/theme-0.1.json",
  "id": "kumikit-light",
  "name": "Kumikit Light",
  "appearance": "light",
  "tokens": {
    "surface.frame": "#f3f4f6",
    "surface.panel": "#ffffff",
    "surface.card": "#ffffff",
    "surface.raised": "#ffffff",
    "surface.overlay": "#0d0f14",
    "surface.input": "#ffffff",
    "surface.hover": "#eef0f4",
    "surface.selected": "#e0e7f7",
    "text.primary": "#1b1d23",
    "text.secondary": "#454a56",
    "text.muted": "#676c7a",
    "text.on-accent": "#ffffff",
    "text.link": "#2650c2",
    "accent": "#3556c4",
    "accent.hover": "#2b49ad",
    "accent.tint": "#e6ecfb",
    "focus": "#3556c4",
    "border.subtle": "#dcdfe6",
    "border.strong": "#858a97",
    "state.success": "#1b7442",
    "state.warning": "#8f5b00",
    "state.danger": "#bf2f39",
    "state.info": "#2a60c4",
    "state.success.tint": "#e4f3e9",
    "state.warning.tint": "#fbf0da",
    "state.danger.tint": "#fbe5e6",
    "state.info.tint": "#e4ecfb",
    "code.background": "#f3f4f7",
    "code.text": "#1b1d23",
    "syntax.keyword": "#8a2fb5",
    "syntax.string": "#1b7442",
    "syntax.number": "#a6530a",
    "syntax.comment": "#676c7a",
    "syntax.function": "#2650c2",
    "syntax.type": "#0f6f78",
    "diff.added": "#1b7442",
    "diff.removed": "#bf2f39",
    "diff.added.tint": "#e4f3e9",
    "diff.removed.tint": "#fbe5e6",
    "shadow.card": "0 1px 2px rgba(15, 18, 25, 0.08)",
    "shadow.raised": "0 4px 12px rgba(15, 18, 25, 0.12)",
    "shadow.overlay": "0 12px 32px rgba(15, 18, 25, 0.24)",
    "overlay.opacity": "0.45",
    "font.ui": "system-ui, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif",
    "font.mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace",
    "font.size.small": "12px",
    "font.size.base": "14px",
    "font.size.large": "16px",
    "font.size.title": "20px",
    "font.weight.normal": "400",
    "font.weight.strong": "600",
    "line-height.base": "1.5",
    "radius.small": "4px",
    "radius.medium": "6px",
    "radius.large": "10px",
    "overlay.blur": "8px",
    "motion.duration.short": "120ms",
    "motion.duration.medium": "200ms",
    "motion.ease.out": "cubic-bezier(0.2, 0, 0, 1)"
  }
}
