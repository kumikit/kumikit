{
  "$schema": "https://kumikit.dev/schema/theme-0.1.json",
  "id": "github-light",
  "name": "GitHub Light",
  "appearance": "light",
  "tokens": {
    "surface.frame": "#f6f8fa",
    "surface.panel": "#ffffff",
    "surface.card": "#ffffff",
    "surface.raised": "#f6f8fa",
    "surface.overlay": "#131518",
    "surface.input": "#ffffff",
    "surface.hover": "#f2f2f2",
    "surface.selected": "#d8e7f9",
    "text.primary": "#1f2328",
    "text.secondary": "#57606a",
    "text.muted": "#656d76",
