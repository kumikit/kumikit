{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kumikit.dev/schema/ui-plugin-manifest-0.1.json",
  "title": "Kumikit UI plugin manifest (plugin.toml), UI SDK 0.1",
  "description": "Structure of plugin.toml for UI plugins (docs/spec/07-ui-plugins.md#manifest). The app's plugin store, kumikit plugin pack and the registry checker also check what a schema cannot say: id and version formats, the api range, that files exist inside the package, and panel network hosts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "kind",
    "api"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "kind": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "enum": [
          "ui"
        ]
      }
    },
    "api": {
      "type": "string"
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry"
      ],
      "properties": {
        "entry": {
          "type": "string"
        },
        "isolation": {
          "enum": [
            "inline",
            "iframe"
          ]
        },
        "network": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "core": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slots": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "settings": {
          "type": "string"
        }
      }
    }
  }
}
