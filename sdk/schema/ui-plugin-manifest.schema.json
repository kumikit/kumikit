{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kumikit.dev/schema/ui-plugin-manifest-0.1.json",
  "title": "Kumikit UI plugin and theme manifest (plugin.toml), UI SDK 0.1",
  "description": "Structure of plugin.toml for UI plugins and themes (docs/spec/07-ui-plugins.md#manifest, 08-themes.md). The app's plugin store, kumikit theme check and the registry checker also check what a schema cannot say: id and version formats, the api range, that files exist inside the package, panel network hosts, and that a theme's tokens are a JSON object.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "kind",
    "api"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "kind": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "enum": [
          "ui",
          "theme"
        ]
      }
    },
    "api": {
      "type": "string"
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry"
      ],
      "properties": {
        "entry": {
          "type": "string"
        },
        "isolation": {
          "enum": [
            "inline",
            "iframe"
          ]
        },
        "network": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variants"
      ],
      "properties": {
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "appearance",
              "tokens"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "appearance": {
                "enum": [
                  "light",
                  "dark"
                ]
              },
              "tokens": {
                "type": "string"
              }
            }
          }
        },
        "fonts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "core": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slots": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "settings": {
          "type": "string"
        }
      }
    }
  }
}
